# Neon PostgreSQL connection strings.
# Get both from the Neon dashboard: Project > Connect.

# Pooled connection (via PgBouncer) — used by the running app (src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/devstash?sslmode=require"

# Direct (unpooled) connection — used by the Prisma CLI for migrations (prisma.config.ts).
# Pooled connections can break migration locks, so this must bypass the pooler.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/devstash?sslmode=require"

# Auth.js
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — verification emails. onboarding@resend.dev only delivers to your own
# Resend account email until you verify a sending domain.
RESEND_API_KEY=""
EMAIL_FROM="DevStash <onboarding@resend.dev>"

# Public origin used to build links in emails (verification, password reset). Set this in
# every deployed environment, e.g. https://devstash.example.com. On Vercel it falls back to
# the project's production domain; locally it defaults to http://localhost:3000. A production
# server with neither fails to send instead of emailing localhost links.
APP_URL="http://localhost:3000"
